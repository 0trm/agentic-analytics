{
  "permissions": {
    "allow": [
      "Bash(bq ls:*)",
      "Bash(bq show:*)",
      "Bash(bq head:*)",
      "Bash(bq query:*)",
      "Bash(gcloud config get-value:*)",
      "Bash(gcloud config configurations list:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(pbcopy:*)"
    ],
    "deny": [
      "Bash(bq rm:*)",
      "Bash(bq cp:*)",
      "Read(./**/service-account*.json)",
      "Read(./**/credentials*.json)",
      "Read(~/.config/gcloud/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/data-freshness.sh"
          }
        ]
      }
    ]
  }
}
